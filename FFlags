    flagList.Visible = false
    presetsList.Visible = true
    updateFlagListHeight()
end)

injectButton.MouseButton1Click:Connect(function()
    if applyFlags() then
        injectButton.BackgroundColor3 = Color3.fromRGB(180, 80, 0)
        injectButton.Text = "INJECTING..."
        task.wait(0.5)
        rejoin()
    end
end)

removeAllButton.MouseButton1Click:Connect(function()
    removeAllFlags()
end)

if getgenv().fast_flags and type(getgenv().fast_flags) == "table" then
    loadFlagsFromTable(getgenv().fast_flags)
end

updateFlagListHeight()

return {
    addFlag = function(name, value, type)
        local rowData = createFlagRow(name, value, type or "Bool", true)
        updateFlagListHeight()
        fadeInRow(rowData.row, 0.3)
    end,
    inject = applyFlags,
    rejoin = rejoin,
    removeAll = removeAllFlags,
    loadFromTable = loadFlagsFromTable,
    addPreset = addFlagsFromPreset
}
