local function loadFlagsFromTable(flagTable)
    if type(flagTable) ~= "table" then
        return
    end
    
    for name, value in pairs(flagTable) do
        local cleanName = name
        local prefixes = {"FFlag", "FInt", "FLog", "FString", "DFFlag", "DFInt", "DFLog", "DFString"}
        for _, prefix in pairs(prefixes) do
            if string.sub(name, 1, #prefix) == prefix then
                cleanName = string.sub(name, #prefix + 1)
                break
            end
        end
        
        local flagType
        if type(value) == "boolean" then
            flagType = "Bool"
        elseif type(value) == "number" then
            flagType = "Int"
        else
            flagType = "String"
        end
        
        createFlagRow(cleanName, value, flagType, false)
    end
    
    updateFlagListHeight()
end

