local function fadeInRow(row, duration)
    duration = duration or 0.3
    row.Visible = true
    row.BackgroundTransparency = 1
    
    local children = row:GetChildren()
    for _, child in pairs(children) do
        if child:IsA("TextBox") or child:IsA("TextButton") then
            child.BackgroundTransparency = 1
            if child:IsA("TextButton") then
                child.TextTransparency = 1
            end
        end
    end
    
    local startTime = tick()
    while tick() - startTime < duration do
        local alpha = (tick() - startTime) / duration
        row.BackgroundTransparency = 1 - alpha
        for _, child in pairs(children) do
            if child:IsA("TextBox") or child:IsA("TextButton") then
                child.BackgroundTransparency = 1 - alpha
                if child:IsA("TextButton") then
                    child.TextTransparency = 1 - alpha
                end
            end
        end
        task.wait()
    end
    
    row.BackgroundTransparency = 0
    for _, child in pairs(children) do
        if child:IsA("TextBox") or child:IsA("TextButton") then
            child.BackgroundTransparency = 0
            if child:IsA("TextButton") then
                child.TextTransparency = 0
            end
        end
    end
end

local function fadeOutRow(row, duration, callback)
    duration = duration or 0.2
    local children = row:GetChildren()
    
    local startTime = tick()
    while tick() - startTime < duration do
        local alpha = (tick() - startTime) / duration
        row.BackgroundTransparency = alpha
        for _, child in pairs(children) do
            if child:IsA("TextBox") or child:IsA("TextButton") then
                child.BackgroundTransparency = alpha
                if child:IsA("TextButton") then
                    child.TextTransparency = alpha
                end
            end
        end
        task.wait()
    end
    
    row.BackgroundTransparency = 1
    for _, child in pairs(children) do
        if child:IsA("TextBox") or child:IsA("TextButton") then
            child.BackgroundTransparency = 1
            if child:IsA("TextButton") then
                child.TextTransparency = 1
            end
        end
    end
    
    if callback then
        callback()
    end
end

