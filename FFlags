local function injectViaUserSettingsFlags(name, value)
    local Settings = game:GetService("UserSettings")
    if Settings and Settings.Flags then
        Settings.Flags[name] = value
    end
    return true
end

local function injectViaUserSettingsSetFlag(name, value)
    local UserSettings = game:GetService("UserSettings")
    if UserSettings and UserSettings.SetFlag then
        UserSettings:SetFlag(name, value)
    end
    return true
end

local function injectViaSettingsService(name, value)
    local Settings = game:GetService("Settings")
    if Settings and Settings.Flags then
        Settings.Flags[name] = value
    end
    return true
end

local function injectViaMemory(name, value)
    if sethiddenproperty then
        sethiddenproperty(game, name, value)
    end
    if setfflag then
        setfflag(name, value)
    end
    return true
end

local function applyFlags()
    local rows = flagList:GetChildren()
    local validRows = {}
    for _, row in pairs(rows) do
        if row:IsA("Frame") then
            table.insert(validRows, row)
        end
    end
    
    if #validRows == 0 then
        return false
    end
    
    for _, row in pairs(validRows) do
        local nameBox = row:FindFirstChild("TextBox")
        local typeBtn = row:FindFirstChild("TextButton")
        local valueBox = row:FindFirstChild("TextBox", true)
        if nameBox and typeBtn and valueBox then
            local name = nameBox.Text:match("^%s*(.-)%s*$")
            local value = valueBox.Text:match("^%s*(.-)%s*$")
            local type = typeBtn.Text
            
            if name and name ~= "" and value then
                local cleanName = name
                local prefixes = {"FFlag", "FInt", "FLog", "FString", "DFFlag", "DFInt", "DFLog", "DFString"}
                for _, prefix in pairs(prefixes) do
                    if string.sub(name, 1, #prefix) == prefix then
                        cleanName = string.sub(name, #prefix + 1)
                        break
                    end
                end
                
                local stringValue
                if type == "Bool" then
                    stringValue = (value:lower() == "true") and "True" or "False"
                elseif type == "Int" then
                    stringValue = tostring(tonumber(value) or 0)
                else
                    stringValue = value
                end
                
                injectViaSetFFlag(cleanName, stringValue)
                injectViaUserSettingsFlags(cleanName, stringValue)
                injectViaUserSettingsSetFlag(cleanName, stringValue)
                injectViaSettingsService(cleanName, stringValue)
                injectViaMemory(cleanName, stringValue)
            end
        end
    end
    
    return true
end

local function rejoin()
